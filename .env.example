# Environment variables — Fase 7
# Salin ke .env dan isi nilai yang sesuai

# Admin credentials (hardcode 1 user)
ADMIN_USERNAME=isi-username-petugas
ADMIN_PASSWORD=isi-password-kuat

# JWT secret — ganti dengan string acak minimal 32 karakter
JWT_SECRET=

# SQLite database path (relatif dari root proyek)
DATABASE_URL=./data/sunggumanai.db

# false untuk database baru yang kosong (tanpa data contoh)
DATABASE_SEED=true

# Wajib true ketika server diakses melalui HTTPS
SESSION_COOKIE_SECURE=false
